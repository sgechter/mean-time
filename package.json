{
  "name": "mean-time",
  "version": "0.1.0",
  "description": "Floating desktop tracker for mean time between interruptions",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-packager . mean-time --platform=darwin --arch=arm64 --icon=build/icon --app-bundle-id=com.sgechter.mean-time --out=dist --overwrite"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^33.0.0"
  }
}
